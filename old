async function saveCampaign(status) {
  const name     = document.getElementById('cc-name')?.value.trim();
  const type     = document.getElementById('cc-type')?.value;
  const budget   = parseFloat(document.getElementById('cc-budget')?.value) || 0;
  const reward   = document.getElementById('cc-reward')?.value;
  const niche    = document.getElementById('cc-niche')?.value || null;
  const deadline = document.getElementById('cc-deadline')?.value || null;
  const brief    = document.getElementById('cc-brief')?.value.trim();
  const errEl    = document.getElementById('cc-err');
  errEl.style.display = 'none';
  if (!name || !brief) { errEl.textContent = 'Campaign name and brief are required.'; errEl.style.display='block'; return; }
  const btn = document.getElementById(`cc-${status === 'active' ? 'launch' : 'draft'}-btn`);
  btn.disabled = true; btn.textContent = 'Saving…';

  // business_id must be the business_profiles.id (not auth.uid)
  const bizProfileId = APP.profileId;

  const payload = {
    name,
    type,
    campaign_type: type?.toLowerCase(),
    budget,
    status,
    niche: niche || null,
    deadline: deadline || null,
    brief,
    requirements: brief,
    description: brief,
    business_id: bizProfileId || null,
    commission_rate: type === 'Affiliate' ? parseFloat(reward) || null : null,
    reward_amount: (type === 'Fixed' || type === 'Hybrid') ? parseFloat(reward) || null : null,
    barter_description: type === 'Barter' ? reward || null : null,
    spent: 0, accepted_count: 0, total_reach: 0, conversions: 0,
  };

  if (APP.user && bizProfileId) {
    const { data, error } = await _sb.from('campaigns').insert(payload).select().single();
    btn.disabled = false; btn.textContent = status === 'active' ? 'Launch Campaign' : 'Save as Draft';
    if (error) { errEl.textContent = error.message; errEl.style.display='block'; return; }
    BIZ_CAMPAIGNS.unshift({
      id: data.id, name: data.name, type: data.type || data.campaign_type, status: data.status,
      budget: `€${Number(data.budget||0).toLocaleString()}`, spent: '€0',
      apps: 0, accepted: 0, reach: '—', conversions: 0, brief: data.brief,
    });
  } else {
    // Demo mode: add locally only
    BIZ_CAMPAIGNS.unshift({ id: Date.now(), name, type, status, budget: `€${budget.toLocaleString()}`, spent: '€0', apps: 0, accepted: 0, reach: '—', conversions: 0 });
    btn.disabled = false; btn.textContent = status === 'active' ? 'Launch Campaign' : 'Save as Draft';
  }
  hideCampaignForm();
  toast(`Campaign "${name}" ${status === 'active' ? 'launched' : 'saved as draft'}!`, 'success');
  const grid = document.getElementById('biz-camp-grid');
  if (grid) grid.innerHTML = BIZ_CAMPAIGNS.map(c => bizCampCard(c)).join('');
  const countEl = document.querySelector('#biz-content p');
  if (countEl) countEl.textContent = `${BIZ_CAMPAIGNS.length} total campaigns`;
}

