          conversions: c.conversions || 0,
          brief: c.brief || c.requirements || c.description,
          deadline: c.deadline,
          niche: c.niche,
          _raw: c,
        }));
      }
    }

    // Load all influencer profiles for discovery
    const { data: infls } = await _sb
      .from('influencer_profiles')
      .select('*')
      .order('rating', { ascending: false })
      .limit(30);
    if (infls?.length) {
      INFLUENCERS = infls.map(i => ({
        id: i.id,
        name: inflName(i),
        handle: inflHandle(i),
        niche: i.niche || 'General',
        followers: fmtFollowers(i.follower_count),
