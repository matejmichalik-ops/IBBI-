// ── Router ─────────────────────────────────────────────────────────────────
function go(page) {
  // hide all top-level pages
  document.querySelectorAll('[id^="page-"], #app-business, #app-influencer').forEach(el => el.classList.add('hidden'));
  // auth pages: hide marketing nav links and auth buttons, keep only logo
  const isApp = page === 'app-business' || page === 'app-influencer';
  const pubNavbar = document.getElementById('pub-navbar');
  if (isApp) {
    if (pubNavbar) pubNavbar.classList.add('hidden');
  } else {
    if (pubNavbar) pubNavbar.classList.remove('hidden');
  }
  // map page names
  const map = {
    'landing': 'page-landing',
    'for-influencers': 'page-for-influencers',
    'for-businesses': 'page-for-businesses',
    'about-us': 'page-about-us',
    'login': 'page-login',
    'signup-role': 'page-signup-role',
    'influencer-signup': 'page-influencer-signup',
    'business-signup': 'page-business-signup',
    'influencer-verification': 'page-influencer-verification',
    'app-business': 'app-business',
    'app-influencer': 'app-influencer',
  };
  const elId = map[page];
  if (elId) {
    const el = document.getElementById(elId);
    if (el) el.classList.remove('hidden');
  }
  window.scrollTo(0,0);
}

