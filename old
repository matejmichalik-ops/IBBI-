    if (camps?.length) {
      INFL_CAMPAIGNS = camps.map(c => ({
        id: c.id,
        name: c.name,
        brand: c.business_profiles?.company_name || 'Unknown',
        brandId: c.business_profiles?.id,
        type: c.type || c.campaign_type,
        status: c.status,
        reward: c.commission_rate
