function fmtFollowers(n) {
  if (!n) return '—';
  if (n >= 1000000) return (n/1000000).toFixed(1).replace('.0','') + 'M';
  if (n >= 1000) return (n/1000).toFixed(0) + 'K';
  return String(n);
}

async function loadUserData(user) {
  APP.user = user;
  const role = user.user_metadata?.role;
  if (!role) return;

  // Helper: display name from profile
  function inflName(i) { return i.full_name || i.name || i.username || i.handle || 'Unknown'; }
  function inflHandle(i) { return i.username || i.handle ? `@${i.username || i.handle}` : '—'; }
  function inflER(i) { return i.engagement_rate || i.avg_engagement_rate; }

  if (role === 'business') {
    // Profiles use user_id FK, not id = auth.uid()
    const { data: profile } = await _sb.from('business_profiles').select('*').eq('user_id', user.id).single();
    APP.profile = profile;
    APP.profileId = profile?.id; // business_profiles.id (used in campaigns.business_id)

    if (profile?.id) {
      const { data: camps } = await _sb
        .from('campaigns')
        .select('*, campaign_applications(count)')
        .eq('business_id', profile.id)
        .order('created_at', { ascending: false });
      if (camps?.length) {
        BIZ_CAMPAIGNS = camps.map(c => ({
          id: c.id,
          name: c.name,
          type: c.type || c.campaign_type,
          status: c.status,
          budget: `€${Number(c.budget || 0).toLocaleString()}`,
          spent: `€${Number(c.spent || 0).toLocaleString()}`,
          apps: c.campaign_applications?.[0]?.count || 0,
          accepted: c.accepted_count || 0,
