function renderBizAnalytics() {
  const tab = S.bizAnalyticsTab;
  const totalConv = BIZ_CAMPAIGNS.reduce((s,c) => s + (Number(c.conversions)||0), 0);
  const totalSpent = BIZ_CAMPAIGNS.reduce((s,c) => s + (parseInt(String(c.spent).replace(/[€,]/g,''))||0), 0);
  const totalReach = BIZ_CAMPAIGNS.reduce((s,c) => {
    const r = String(c.reach); if (r === '—') return s;
    if (r.includes('M')) return s + parseFloat(r)*1000000;
    if (r.includes('K')) return s + parseFloat(r)*1000;
    return s + (parseInt(r)||0);
  }, 0);
  const roas = totalSpent > 0 && totalConv > 0 ? (totalConv / totalSpent * 3).toFixed(1) + '×' : '—';
  return `
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-bottom:28px">
    ${statCard('Total Reach', totalReach >= 1000000 ? (totalReach/1000000).toFixed(1).replace('.0','')+'M' : totalReach >= 1000 ? Math.round(totalReach/1000)+'K' : (totalReach||'—'), 'Across all campaigns', totalReach ? 'up' : '', 'eye')}
    ${statCard('Total Conversions', totalConv ? totalConv.toLocaleString() : '—', 'All campaigns', totalConv ? 'up' : '', 'bolt')}
    ${statCard('Total Spent', totalSpent ? `€${totalSpent.toLocaleString()}` : '€0', 'Campaign budget used', '', 'bar-chart')}
    ${statCard('ROAS', roas, 'Return on ad spend', roas !== '—' ? 'up' : '', 'coin')}
  </div>
  <div class="card" style="margin-bottom:24px">
    <div class="tab-bar">
      ${['performance','campaigns','collaboration'].map(t=>`<button class="tab-btn ${tab===t?'active':''}" onclick="setBizAnalyticsTab('${t}')">${t.charAt(0).toUpperCase()+t.slice(1)}</button>`).join('')}
    </div>
    ${tab==='performance' ? `
      <div style="display:grid;grid-template-columns:2fr 1fr;gap:24px">
        <div><h4 style="color:var(--navy);margin:0 0 12px">Monthly Reach & Conversions</h4><div class="chart-wrap"><canvas id="biz-perf-chart"></canvas></div></div>
        <div><h4 style="color:var(--navy);margin:0 0 12px">Campaign Mix</h4><div class="chart-wrap"><canvas id="biz-mix-chart"></canvas></div></div>
      </div>` : ''}
    ${tab==='campaigns' ? `
      <h4 style="color:var(--navy);margin:0 0 12px">Campaign Performance Comparison</h4>
      <div class="chart-wrap"><canvas id="biz-camp-chart"></canvas></div>
      <table class="data-table" style="margin-top:20px">
        <thead><tr><th>Campaign</th><th>Type</th><th>Reach</th><th>Conversions</th><th>Spent</th><th>ROAS</th></tr></thead>
        <tbody>
          ${BIZ_CAMPAIGNS.filter(c=>c.status!=='draft').map(c=>`<tr>
            <td style="font-weight:600">${c.name}</td>
            <td>${typeBadge(c.type)}</td>
            <td>${c.reach}</td>
            <td>${c.conversions.toLocaleString()}</td>
            <td>${c.spent}</td>
            <td class="badge badge-green">${c.conversions > 0 ? (c.conversions / (parseInt(c.spent.replace(/[€,]/g,''))||1) * 3).toFixed(1) + '×' : '—'}</td>
          </tr>`).join('')}
        </tbody>
      </table>` : ''}
    ${tab==='collaboration' ? `
      <h4 style="color:var(--navy);margin:0 0 12px">Influencer Performance</h4>
      <div class="chart-wrap"><canvas id="biz-collab-chart"></canvas></div>` : ''}
  </div>`;
}

