<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IBBI — Connect Influencers & Businesses</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --blue:#2079FF;--blue-dark:#0A4FD4;--blue-deeper:#083BB0;
  --navy:#0D1B3E;--blue-light:#EBF3FF;--blue-mid:#C5DEFF;--blue-soft:#F0F7FF;
  --white:#fff;--text:#0D1B3E;--text-mid:#4A6FA5;--text-light:#8EAFD4;
  --border:#D6E8FF;--shadow:0 4px 24px rgba(32,121,255,.10);
  --shadow-lg:0 12px 48px rgba(32,121,255,.18);--radius:14px;--sidebar-w:108px;
}
html{scroll-behavior:smooth}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--white);color:var(--text);line-height:1.6}
a{text-decoration:none;color:inherit}
.hidden{display:none!important}
h1{font-size:clamp(2rem,5vw,3.4rem);font-weight:900;line-height:1.12;letter-spacing:-.03em}
h2{font-size:clamp(1.5rem,3vw,2.4rem);font-weight:800;line-height:1.2;letter-spacing:-.02em}
h3{font-size:1.2rem;font-weight:700}
p{color:var(--text-mid)}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;gap:8px;border:none;border-radius:50px;padding:12px 28px;font-size:.95rem;font-weight:700;cursor:pointer;transition:all .2s;text-decoration:none}
.btn-blue,.btn-primary{background:var(--blue);color:#fff}
.btn-blue:hover,.btn-primary:hover{background:var(--blue-dark);transform:translateY(-1px);box-shadow:0 6px 20px rgba(32,121,255,.35)}
.btn-outline{background:transparent;color:var(--blue);border:2px solid var(--blue)}
.btn-outline:hover{background:var(--blue-light)}
.btn-white{background:#fff;color:var(--blue)}
.btn-white:hover{background:#f0f7ff;transform:translateY(-1px)}
.btn-ghost{background:transparent;color:var(--text-mid);border:none;font-weight:600;font-size:.9rem;cursor:pointer;padding:8px 16px;border-radius:50px}
.btn-ghost:hover{background:var(--blue-light);color:var(--blue)}
.btn-secondary{background:var(--blue-light);color:var(--blue);border:1.5px solid var(--blue-mid)}
.btn-secondary:hover{background:var(--blue-mid);color:var(--blue-dark)}
.btn-lg{padding:16px 40px;font-size:1.05rem}
.btn-sm{padding:8px 20px;font-size:.85rem}

/* PUBLIC NAVBAR */
.pub-nav{position:sticky;top:0;z-index:200;background:rgba(255,255,255,.95);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 40px;height:68px;gap:24px}
.nav-logo{font-size:1.9rem;font-weight:900;color:var(--blue);letter-spacing:-2px;cursor:pointer;flex-shrink:0}
.nav-links{display:flex;gap:4px;flex:1;justify-content:center}
.nav-link{padding:8px 16px;border-radius:50px;font-weight:600;font-size:.9rem;color:var(--text-mid);cursor:pointer;transition:all .2s;background:none;border:none}
.nav-link:hover,.nav-link.active{color:var(--blue);background:var(--blue-light)}
.nav-actions{display:flex;gap:10px;align-items:center}

/* SECTIONS */
section{padding:88px 40px}
.container{max-width:1120px;margin:0 auto}
.section-tag{display:inline-block;background:var(--blue-light);color:var(--blue);font-size:.78rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:5px 14px;border-radius:50px;margin-bottom:14px}
.section-head{text-align:center;max-width:680px;margin:0 auto 56px}
.section-head h2{margin-bottom:14px}
.section-head p{font-size:1rem}

/* HERO */
.hero{background:linear-gradient(135deg,var(--navy) 0%,#0A3A8F 55%,var(--blue) 100%);padding:100px 40px 80px;color:#fff;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 70% 50%,rgba(32,121,255,.25) 0%,transparent 60%);pointer-events:none}
.hero-inner{max-width:1120px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.hero-tag{display:inline-block;background:rgba(255,255,255,.15);color:#fff;font-size:.78rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:5px 14px;border-radius:50px;margin-bottom:18px;backdrop-filter:blur(8px)}
.hero h1{color:#fff;margin-bottom:18px}
.hero h1 span{color:#7EC8FF}
.hero-sub{font-size:1.05rem;color:rgba(255,255,255,.78);margin-bottom:32px;line-height:1.75}
.hero-btns{display:flex;gap:12px;flex-wrap:wrap}
.hero-stats{display:flex;gap:28px;margin-top:40px;padding-top:32px;border-top:1px solid rgba(255,255,255,.15);flex-wrap:wrap}
.hstat-val{font-size:1.55rem;font-weight:900;color:#fff}
.hstat-lbl{font-size:.76rem;color:rgba(255,255,255,.55);margin-top:1px}

/* HERO MOCKUP */
.hero-mockup{position:relative;animation:float 6s ease-in-out infinite}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
.mockup-window{background:rgba(255,255,255,.09);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,.18);border-radius:20px;overflow:hidden;box-shadow:0 24px 80px rgba(0,0,0,.3)}
.mockup-bar{background:rgba(0,0,0,.25);padding:12px 18px;display:flex;align-items:center;gap:8px}
.mdot{width:10px;height:10px;border-radius:50%}
.mockup-body{padding:18px;display:grid;grid-template-columns:68px 1fr;gap:12px;min-height:280px}
.mockup-sidebar{display:flex;flex-direction:column;gap:6px}
.ms-item{background:rgba(255,255,255,.1);border-radius:18px;padding:6px 4px;font-size:.6rem;font-weight:700;color:rgba(255,255,255,.5);text-align:center}
.ms-item.act{background:rgba(32,121,255,.5);color:#fff}
.mockup-content{display:grid;grid-template-columns:1fr 1fr;gap:8px;align-content:start}
.mc-card{background:rgba(255,255,255,.1);border-radius:9px;padding:10px 11px}
.mc-val{font-size:1rem;font-weight:800;color:#fff}
.mc-lbl{font-size:.58rem;color:rgba(255,255,255,.55);margin-top:2px}
.mc-bars{grid-column:1/-1;background:rgba(255,255,255,.06);border-radius:9px;padding:10px;height:76px;display:flex;align-items:flex-end;gap:5px}
.mc-bar{flex:1;border-radius:3px 3px 0 0}

/* FEATURES */
.features-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.feature-card{background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius);padding:28px;transition:all .25s;cursor:default}
.feature-card:hover{border-color:var(--blue-mid);box-shadow:var(--shadow);transform:translateY(-3px)}
.fi{width:50px;height:50px;border-radius:13px;background:var(--blue-light);display:flex;align-items:center;justify-content:center;font-size:1.4rem;margin-bottom:14px}
.feature-card h3{margin-bottom:7px;font-size:1rem}
.feature-card p{font-size:.85rem;line-height:1.65}

/* HOW IT WORKS */
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;position:relative}
.steps::before{content:'';position:absolute;top:26px;left:17%;right:17%;height:2px;background:linear-gradient(90deg,var(--blue-mid),var(--blue));opacity:.4}
.step{text-align:center;padding:22px 14px}
.step-num{width:52px;height:52px;border-radius:50%;background:var(--blue);color:#fff;font-size:1.2rem;font-weight:900;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;position:relative;z-index:1;box-shadow:0 4px 16px rgba(32,121,255,.4)}
.step h3{margin-bottom:7px;font-size:1rem}
.step p{font-size:.85rem}

/* CAMPAIGN TYPES */
.ctypes{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.ctype-card{border-radius:var(--radius);padding:26px 20px;text-align:center;border:1.5px solid var(--border);transition:all .25s;background:var(--white)}
.ctype-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg);border-color:var(--blue)}
.ctype-icon{font-size:2rem;margin-bottom:12px}
.ctype-card h3{font-size:.95rem;margin-bottom:7px;color:var(--text)}
.ctype-card p{font-size:.8rem;line-height:1.6}
.ctype-tag{display:inline-block;margin-top:10px;font-size:.7rem;font-weight:700;padding:3px 11px;border-radius:50px;background:var(--blue-light);color:var(--blue)}

/* STATS STRIP */
.stats-strip{background:linear-gradient(135deg,var(--navy),#0A3A8F);padding:56px 40px}
.stats-inner{max-width:1120px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:24px;text-align:center}
.sbv{font-size:2.2rem;font-weight:900;color:#fff;margin-bottom:5px}
.sbl{font-size:.85rem;color:rgba(255,255,255,.55);font-weight:500}

/* SPLIT SECTION */
.split{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
.split-img{border-radius:20px;overflow:hidden;background:linear-gradient(135deg,var(--blue-light),var(--blue-mid));min-height:360px;display:flex;align-items:center;justify-content:center;position:relative}
.split-text h2{margin-bottom:14px}
.split-text p{margin-bottom:18px;font-size:.95rem;line-height:1.75}
.check-list{list-style:none;display:flex;flex-direction:column;gap:9px;margin-bottom:26px}
.check-list li{display:flex;align-items:flex-start;gap:10px;font-size:.88rem;color:var(--text-mid)}
.check-list li::before{content:'✓';width:20px;height:20px;border-radius:50%;background:var(--blue);color:#fff;font-size:.68rem;font-weight:900;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px}

/* COMPARISON */
.compare-table{width:100%;border-collapse:collapse;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow)}
.compare-table th{padding:14px 18px;font-size:.8rem;font-weight:700;border-bottom:1px solid var(--border);text-align:center}
.compare-table th:first-child{text-align:left;background:var(--blue-soft)}
.compare-table th.hl{background:var(--blue);color:#fff}
.compare-table th:not(:first-child):not(.hl){background:#fafafa;color:var(--text-light)}
.compare-table td{padding:12px 18px;font-size:.85rem;border-bottom:1px solid var(--border);text-align:center}
.compare-table td:first-child{font-weight:600;text-align:left;background:var(--blue-soft)}
.compare-table .ib{background:rgba(32,121,255,.04)}
.compare-table .yes{color:var(--blue);font-weight:700}
.compare-table .no{color:#ccc}
.compare-table tr:last-child td{border-bottom:none}

/* CTA BANNER */
.cta-banner{background:linear-gradient(135deg,var(--blue-dark),var(--blue));border-radius:22px;padding:60px 52px;text-align:center;color:#fff;position:relative;overflow:hidden}
.cta-banner::before{content:'';position:absolute;top:-50%;right:-5%;width:380px;height:380px;border-radius:50%;background:rgba(255,255,255,.07);pointer-events:none}
.cta-banner h2{color:#fff;margin-bottom:12px}
.cta-banner p{color:rgba(255,255,255,.72);margin-bottom:30px;font-size:.98rem}
.cta-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}

/* FOOTER */
footer{background:var(--navy);color:rgba(255,255,255,.55);padding:56px 40px 30px}
.footer-inner{max-width:1120px;margin:0 auto}
.footer-top{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:44px;margin-bottom:44px}
.footer-logo{font-size:1.75rem;font-weight:900;color:var(--blue);letter-spacing:-1px;margin-bottom:10px}
.footer-desc{font-size:.84rem;line-height:1.7}
.footer-col h4{color:#fff;font-size:.82rem;font-weight:700;margin-bottom:14px;letter-spacing:.05em;text-transform:uppercase}
.footer-col a{display:block;font-size:.82rem;margin-bottom:9px;cursor:pointer;transition:color .2s}
.footer-col a:hover{color:#fff}
.footer-bottom{border-top:1px solid rgba(255,255,255,.08);padding-top:22px;display:flex;justify-content:space-between;font-size:.78rem}

/* PAGE HERO */
.page-hero{padding:80px 40px;background:linear-gradient(135deg,var(--navy),var(--blue-dark));color:#fff;text-align:center}
.page-hero h1{color:#fff;margin-bottom:14px}
.page-hero .sub{color:rgba(255,255,255,.72);font-size:1.05rem;max-width:560px;margin:0 auto 28px}
.page-hero-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}

/* BENEFITS */
.benefits-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
.ben-card{background:var(--blue-soft);border:1.5px solid var(--border);border-radius:var(--radius);padding:24px;display:flex;gap:16px;align-items:flex-start;transition:all .2s}
.ben-card:hover{border-color:var(--blue);box-shadow:var(--shadow)}
.ben-icon{width:44px;height:44px;border-radius:12px;background:var(--blue);display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0}
.ben-text h3{font-size:.95rem;margin-bottom:5px}
.ben-text p{font-size:.82rem;line-height:1.6}

/* ABOUT */
.values-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.val-card{text-align:center;padding:30px 22px;background:var(--blue-soft);border-radius:var(--radius);border:1.5px solid var(--border)}
.val-icon{font-size:2.2rem;margin-bottom:14px}
.problem-box{background:linear-gradient(135deg,#fff5f5,#fff);border:1.5px solid #fecaca;border-radius:var(--radius);padding:24px 28px;margin-bottom:16px}
.problem-box h3{color:#dc2626;margin-bottom:8px;font-size:1rem}
.problem-box p{font-size:.88rem;line-height:1.65}
.solution-box{background:linear-gradient(135deg,var(--blue-soft),#fff);border:1.5px solid var(--blue-mid);border-radius:var(--radius);padding:24px 28px}
.solution-box h3{color:var(--blue);margin-bottom:8px;font-size:1rem}
.solution-box p{font-size:.88rem;line-height:1.65}

/* AUTH */
.auth-page{min-height:100vh;background:linear-gradient(135deg,var(--navy) 0%,var(--blue-dark) 100%);display:flex;flex-direction:column}
.auth-top-nav{padding:18px 40px;display:flex;align-items:center;justify-content:space-between}
.auth-logo{font-size:1.8rem;font-weight:900;color:#fff;letter-spacing:-2px;cursor:pointer}
.auth-logo span{color:#7EC8FF}
.auth-top-actions{display:flex;gap:10px}
.auth-center{flex:1;display:flex;align-items:center;justify-content:center;padding:32px 20px}
.auth-card{background:#fff;border-radius:22px;padding:42px 38px;width:420px;box-shadow:0 24px 80px rgba(0,0,0,.25)}
.auth-card-title{font-size:1.45rem;font-weight:800;color:var(--text);margin-bottom:5px}
.auth-card-sub{font-size:.85rem;color:var(--text-mid);margin-bottom:26px}
.auth-tabs{display:flex;background:var(--blue-soft);border-radius:12px;padding:4px;margin-bottom:22px}
.auth-tab{flex:1;padding:9px;text-align:center;border-radius:9px;font-size:.86rem;font-weight:600;cursor:pointer;transition:all .2s;color:var(--text-mid);border:none;background:none}
.auth-tab.active{background:#fff;color:var(--blue);box-shadow:0 2px 8px rgba(0,0,0,.08)}
.auth-input{width:100%;padding:12px 15px;border:1.5px solid var(--border);border-radius:10px;font-size:.92rem;outline:none;margin-bottom:12px;color:var(--text);background:#fff;transition:border-color .2s}
.auth-input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(32,121,255,.1)}
.auth-btn{width:100%;padding:13px;background:var(--blue);color:#fff;border:none;border-radius:12px;font-size:.98rem;font-weight:700;cursor:pointer;transition:all .2s;margin-bottom:12px}
.auth-btn:hover{background:var(--blue-dark)}
.auth-link{text-align:center;font-size:.82rem;color:var(--text-mid);cursor:pointer}
.auth-link span{color:var(--blue);font-weight:600;cursor:pointer}
.auth-link:hover{color:var(--blue)}
.chk-row{display:flex;align-items:center;gap:9px;margin-bottom:14px;font-size:.85rem;color:var(--text-mid)}
.chk-row input{width:16px;height:16px;accent-color:var(--blue);cursor:pointer}

/* ROLE PICK */
.role-pick-row{display:flex;gap:22px;justify-content:center;flex-wrap:wrap;padding:48px 20px}
.role-card{width:290px;background:#fff;border-radius:22px;padding:34px 26px;text-align:center;cursor:pointer;transition:all .25s;border:2px solid transparent;box-shadow:0 8px 32px rgba(0,0,0,.1)}
.role-card:hover{border-color:var(--blue);transform:translateY(-6px);box-shadow:0 16px 48px rgba(32,121,255,.2)}
.role-icon{width:68px;height:68px;border-radius:18px;background:var(--blue-light);display:flex;align-items:center;justify-content:center;font-size:1.9rem;margin:0 auto 16px}
.role-card h3{color:var(--text);margin-bottom:7px}
.role-card p{font-size:.82rem;margin-bottom:18px}

/* VERIFY */
.verify-card{background:#fff;border-radius:22px;padding:42px 38px;width:480px;box-shadow:0 24px 80px rgba(0,0,0,.25)}
.soc-row{display:flex;align-items:center;gap:12px;margin-bottom:12px;padding:13px 16px;background:var(--blue-soft);border:1.5px solid var(--border);border-radius:12px;transition:all .2s}
.soc-row.connected{border-color:var(--blue);background:var(--blue-light)}
.s-ic{width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0}
.s-nm{flex:1;font-weight:600;font-size:.88rem}
.s-cbtn{padding:6px 16px;border-radius:50px;border:1.5px solid var(--blue);background:none;color:var(--blue);font-weight:700;font-size:.78rem;cursor:pointer;transition:all .2s}
.s-cbtn.done,.s-cbtn:hover{background:var(--blue);color:#fff}
.s-chk{width:20px;height:20px;border-radius:50%;border:1.5px solid var(--border);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:.65rem;transition:all .2s}
.s-chk.ok{background:var(--blue);border-color:var(--blue);color:#fff}

/* APP LAYOUT */
.app-wrapper{display:flex;flex-direction:column;min-height:100vh}
.app-header{display:flex;align-items:center;background:#fff;border-bottom:1px solid var(--border);padding:0 20px;height:56px;position:sticky;top:0;z-index:100;gap:14px}
.app-logo{font-size:1.4rem;font-weight:900;color:var(--blue);letter-spacing:-1px;cursor:pointer}
.app-title{flex:1;text-align:center;font-size:.95rem;font-weight:700;color:var(--text-mid)}
.app-hbtns{display:flex;gap:8px}
.app-hbtns button{padding:6px 15px;background:var(--blue-soft);border:1px solid var(--border);border-radius:50px;font-weight:600;cursor:pointer;font-size:.78rem;color:var(--text-mid);transition:all .2s}
.app-hbtns button:hover{background:var(--blue-light);color:var(--blue);border-color:var(--blue-mid)}
.app-body{display:flex;flex:1}
.sidebar{width:var(--sidebar-w);background:var(--navy);padding:14px 8px;display:flex;flex-direction:column;gap:4px;flex-shrink:0;min-height:calc(100vh - 56px)}
.nav-item{background:transparent;border:none;border-radius:10px;padding:9px 5px;font-size:.72rem;font-weight:600;cursor:pointer;text-align:center;width:100%;transition:all .2s;color:rgba(255,255,255,.4)}
.nav-item:hover{background:rgba(255,255,255,.08);color:rgba(255,255,255,.75)}
.nav-item.active{background:rgba(32,121,255,.3);color:#fff;box-shadow:inset 0 0 0 1px rgba(32,121,255,.5)}
.ni-icon{font-size:1.1rem;display:block;margin-bottom:3px}
.sidebar-spacer{flex:1}
.app-content{flex:1;background:var(--blue-soft);padding:20px;overflow-y:auto}
.page-card{background:#fff;border-radius:var(--radius);padding:24px;box-shadow:0 2px 8px rgba(32,121,255,.06)}
.pct{font-size:1.35rem;font-weight:800;color:var(--text);margin-bottom:20px;display:flex;align-items:center;justify-content:space-between}

/* APP TABS */
.stabs{display:flex;gap:8px;margin-bottom:20px;flex-wrap:wrap}
.stab{background:var(--blue-soft);border:1px solid var(--border);border-radius:50px;padding:7px 18px;font-weight:600;font-size:.82rem;cursor:pointer;color:var(--text-mid);transition:all .2s}
.stab.active{background:var(--blue);color:#fff;border-color:var(--blue)}
.stab:hover:not(.active){background:var(--blue-light);border-color:var(--blue-mid)}
.ttabs{display:flex;gap:6px;margin-bottom:16px}
.ttab{background:#fff;border:1px solid var(--border);border-radius:8px;padding:5px 13px;font-size:.78rem;font-weight:600;cursor:pointer;color:var(--text-mid)}
.ttab.active{background:var(--navy);color:#fff;border-color:var(--navy)}

/* STAT CARDS */
.stats-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;margin-bottom:18px}
.stat-card{background:#fff;border:1px solid var(--border);border-radius:12px;padding:15px;box-shadow:0 2px 6px rgba(32,121,255,.04)}
.si{width:36px;height:36px;border-radius:9px;background:var(--blue-light);display:flex;align-items:center;justify-content:center;font-size:1rem;margin-bottom:9px}
.sl{font-size:.72rem;font-weight:600;color:var(--text-light);margin-bottom:4px;line-height:1.3}
.sv{font-size:1.2rem;font-weight:800;color:var(--text)}
.st{font-size:.7rem;font-weight:600;margin-top:2px}
.st.up{color:#15803d}.st.neutral{color:var(--text-light)}

/* TABLE */
.app-table{width:100%;border-collapse:collapse}
.app-table th{text-align:left;padding:9px 13px;font-size:.74rem;font-weight:700;color:var(--text-light);border-bottom:1.5px solid var(--border);text-transform:uppercase;letter-spacing:.04em}
