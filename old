function enterApp(role) {
  S.role = role;
  if (role === 'business') {
    go('app-business');
    bizPage('dashboard');
  } else {
    go('app-influencer');
    inflPage('dashboard');
  }
  _sb.auth.getUser().then(({ data: { user } }) => {
    if (user) loadUserData(user);
  });
}

